{
    "model_type": "openpi",
    "openpi": {
        "host": "localhost",
        "port": 8000,
        "default_prompt": "Assist the operator in tying a suture knot by handing over the scissors and needle driver as needed.",
        "image_size": [
            224,
            224
        ],
        "obs_keys": {
            "mount_image": "observation/mount_image",
            "gripper_image": "observation/gripper_image",
            "side_image": "observation/side_image",
            "state": "observation/state"
        }
    },
    "dataset": {
        "action_mode": "absolute",
        "orientation_rep": "quaternion"
    },
    "hardgate": {
        "enabled": false,
        "threshold": 0.5,
        "consecutive_moves_required": 3
    },
    "inference": {
        "inference_publish_hz": 10,
        "reset_pose": {
            "position": {
                "x": 0.3546,
                "y": 0.0925,
                "z": 0.477
            },
            "orientation": {
                "x": 0.7306,
                "y": -0.6817,
                "z": -0.0388,
                "w": 0.0032
            },
            "gripper": 538.0
        }
    }
}
